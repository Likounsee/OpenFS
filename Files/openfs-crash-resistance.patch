+#[test]
+fn power_cut_sweep_smoke() {
+    const QUICK: [&str; 4] = [
+        "create_file",
+        "remove_file",
+        "truncate_shrink",
+        "range_write_in_place",
+    ];
+    for scenario in scenarios()
+        .into_iter()
+        .filter(|scenario| QUICK.contains(&scenario.name))
+    {
+        sweep(&scenario, 4096);
+    }
+}
